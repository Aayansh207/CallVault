{
  "name": "callvault",
  "version": "1.0.0",
  "description": "Personal Call Recording Manager - Local-first desktop app",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"VITE,ELEC\" -c \"cyan,magenta\" \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && electron .",
    "build": "vite build",
    "preview": "vite preview",
    "start": "cross-env NODE_ENV=production electron .",
    "rebuild": "npx @electron/rebuild -f -w better-sqlite3"
  },
  "keywords": [
    "call-recordings",
    "electron",
    "react",
    "local-first",
    "audio-manager"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "chokidar": "^4.0.3",
    "lucide-react": "^1.16.0",
    "music-metadata": "^7.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1"
  }
}
